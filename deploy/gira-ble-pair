#!/usr/bin/env bash
# Pair a Gira System 3000 device with BlueZ (Raspberry Pi).
#
# Usage:
#   sudo gira-ble-pair C7:F5:40:A6:81:66
#   sudo gira-ble-pair -s 30 C7:F5:40:A6:81:66
#
# Put the device into pairing mode (BT / blue LED blinking) BEFORE / when prompted.
#
# Gira units request User Confirm (often passkey 000000). We drive bluetoothctl
# via expect with agent DisplayYesNo and auto-send "yes".
# (Older BlueZ builds lack `btmgmt user-confirm-reply`.)

set -euo pipefail

DEFAULT_SCAN_SECONDS=20
SCAN_SECONDS="${GIRA_BLE_PAIR_SCAN_SECONDS:-$DEFAULT_SCAN_SECONDS}"
STOP_SERVICE="${GIRA_BLE_PAIR_STOP_SERVICE:-1}"
SERVICE_NAME="${GIRA_BLE_SERVICE:-gira-ble-api}"
FORCE_PAIR=0

usage() {
  cat <<EOF
Usage: $(basename "$0") [options] <MAC>

Pair/trust a Gira BLE device via BlueZ (auto-confirms passkey).

Options:
  -s, --seconds N   BLE scan window before pair (default ${DEFAULT_SCAN_SECONDS})
  -f, --force       Pair even if the MAC was not seen during scan
  -h, --help        Show this help

Requires: bluetoothctl, expect  (sudo apt install expect)

Example:
  sudo $(basename "$0") C7:F5:40:A6:81:66
  sudo $(basename "$0") -s 30 C7:F5:40:A6:81:66

Env (overridden by flags when set):
  GIRA_BLE_PAIR_SCAN_SECONDS    discover window (default ${DEFAULT_SCAN_SECONDS})
  GIRA_BLE_PAIR_STOP_SERVICE    stop ${SERVICE_NAME} during pair (default 1)
EOF
}

device_seen() {
  bluetoothctl devices 2>/dev/null | grep -qi "${MAC}"
}

normalize_mac() {
  local raw="${1^^}"
  raw="${raw//-/:}"
  raw="${raw//./:}"
  printf '%s\n' "${raw}"
}

valid_mac() {
  [[ "${1}" =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]]
}

is_paired() {
  bluetoothctl info "${MAC}" 2>/dev/null | grep -qi 'Paired: yes'
}

cleanup() {
  bluetoothctl scan off >/dev/null 2>&1 || true
  if [[ "${SERVICE_WAS_ACTIVE:-0}" -eq 1 ]]; then
    echo "==> Restarting ${SERVICE_NAME}"
    systemctl start "${SERVICE_NAME}" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

MAC_ARG=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -s | --seconds)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for $1" >&2
        usage >&2
        exit 2
      fi
      SCAN_SECONDS="$2"
      shift 2
      ;;
    --seconds=*)
      SCAN_SECONDS="${1#*=}"
      shift
      ;;
    -f | --force)
      FORCE_PAIR=1
      shift
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ -n "${MAC_ARG}" ]]; then
        echo "Unexpected argument: $1" >&2
        usage >&2
        exit 2
      fi
      MAC_ARG="$1"
      shift
      ;;
  esac
done

if [[ -z "${MAC_ARG}" ]]; then
  usage >&2
  exit 2
fi

if ! [[ "${SCAN_SECONDS}" =~ ^[0-9]+$ ]] || [[ "${SCAN_SECONDS}" -lt 1 ]]; then
  echo "Invalid --seconds value: ${SCAN_SECONDS} (need integer >= 1)" >&2
  exit 2
fi

if [[ "${EUID}" -ne 0 ]]; then
  echo "Run as root (e.g. sudo $(basename "$0") ${MAC_ARG})." >&2
  exit 1
fi

if ! command -v bluetoothctl >/dev/null 2>&1; then
  echo "bluetoothctl not found (install bluez)." >&2
  exit 1
fi

if ! command -v expect >/dev/null 2>&1; then
  echo "expect not found. Install with: sudo apt install expect" >&2
  exit 1
fi

MAC="$(normalize_mac "${MAC_ARG}")"
if ! valid_mac "${MAC}"; then
  echo "Invalid MAC address: ${MAC_ARG} (expected AA:BB:CC:DD:EE:FF)" >&2
  exit 2
fi

SERVICE_WAS_ACTIVE=0
if [[ "${STOP_SERVICE}" == "1" ]] && systemctl is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
  echo "==> Stopping ${SERVICE_NAME} so it does not hold the adapter"
  systemctl stop "${SERVICE_NAME}"
  SERVICE_WAS_ACTIVE=1
  sleep 1
fi

echo "==> Target ${MAC}"
echo "==> Put the device in pairing mode (BT icon / blue LED blinking),"
echo "    stay within ~1 m of the Pi, then press Enter…"
read -r _

echo "==> Removing any previous bond"
bluetoothctl remove "${MAC}" >/dev/null 2>&1 || true

if command -v btmgmt >/dev/null 2>&1; then
  echo "==> Adapter: power / connectable / bondable"
  btmgmt power on >/dev/null 2>&1 || true
  btmgmt connectable on >/dev/null 2>&1 || true
  btmgmt bondable on >/dev/null 2>&1 || true
else
  bluetoothctl power on >/dev/null 2>&1 || true
fi

echo "==> Scanning up to ${SCAN_SECONDS}s (exits early when ${MAC} appears)."
echo "    Press Enter as soon as the LED blinks — Gira windows are short."

if ! bluetoothctl scan on >/dev/null 2>&1; then
  echo "ERROR: 'bluetoothctl scan on' failed. Is bluetoothd running?" >&2
  echo "  sudo systemctl start bluetooth" >&2
  exit 1
fi

SEEN=0
for ((elapsed = 1; elapsed <= SCAN_SECONDS; elapsed++)); do
  sleep 1
  if device_seen; then
    SEEN=1
    echo "==> Seen after ${elapsed}s: $(bluetoothctl devices 2>/dev/null | grep -i "${MAC}" || true)"
    break
  fi
  if ((elapsed % 5 == 0)); then
    count="$(bluetoothctl devices 2>/dev/null | wc -l | tr -d ' ')"
    echo "    … ${elapsed}s, ${count} device(s) in BlueZ cache (target not yet)"
  fi
done

if [[ "${SEEN}" -ne 1 ]]; then
  if [[ "${FORCE_PAIR}" -eq 1 ]]; then
    echo "WARNING: ${MAC} not seen during scan — continuing because --force."
  else
    bluetoothctl scan off >/dev/null 2>&1 || true
    echo "ERROR: ${MAC} was not discovered during the ${SCAN_SECONDS}s scan." >&2
    echo "  Nearby devices BlueZ did see:" >&2
    bluetoothctl devices 2>/dev/null | sed 's/^/    /' >&2 || echo "    (none)" >&2
    echo "  - Re-enter pairing mode and press Enter as soon as LED blinks" >&2
    echo "  - Confirm MAC with: gira-ble-api scan" >&2
    echo "  - Stand closer; forget phone/Gira-app bond for this unit" >&2
    exit 1
  fi
fi

# Pair + auto-yes via expect (works without btmgmt user-confirm-reply).
PAIR_LOG="$(mktemp /tmp/gira-ble-pair.XXXXXX)"
echo "==> Pair ${MAC} (bluetoothctl DisplayYesNo + auto-yes)"
set +e
expect <<EOF >"${PAIR_LOG}" 2>&1
set timeout 60
log_user 1
spawn bluetoothctl
expect -re {# |> }
send "power on\r"
expect -re {# |> }
send "pairable on\r"
expect -re {# |> }
send "agent off\r"
expect -re {# |> }
send "agent DisplayYesNo\r"
expect -re {# |> }
send "default-agent\r"
expect -re {# |> }
send "pair ${MAC}\r"
expect {
  -re {Confirm passkey|Request confirmation|Authorize service|Confirm value} {
    send "yes\r"
    exp_continue
  }
  -re {Pairing successful|AlreadyExists|Already Paired} { }
  -re {Failed to pair|AuthenticationCanceled|Authentication Failed} {
    puts "PAIR_FAILED"
    exit 1
  }
  timeout {
    puts "PAIR_TIMEOUT"
    exit 1
  }
  eof {
    puts "PAIR_EOF"
    exit 1
  }
}
send "trust ${MAC}\r"
expect -re {# |> }
send "quit\r"
expect eof
EOF
PAIR_RC=$?
set -e

cat "${PAIR_LOG}"
rm -f "${PAIR_LOG}"

bluetoothctl scan off >/dev/null 2>&1 || true

echo "==> Trust ${MAC} (idempotent)"
bluetoothctl trust "${MAC}" >/dev/null 2>&1 || true

if ! is_paired && ! bluetoothctl devices Paired 2>/dev/null | grep -qi "${MAC}"; then
  echo "==> Connect (optional verification)"
  set +e
  CONN_OUT="$(bluetoothctl connect "${MAC}" 2>&1)"
  CONN_RC=$?
  set -e
  printf '%s\n' "${CONN_OUT}"
  if [[ "${CONN_RC}" -eq 0 ]]; then
    sleep 1
    bluetoothctl disconnect "${MAC}" >/dev/null 2>&1 || true
  fi
fi

sleep 1
echo
echo "==> Device info:"
bluetoothctl info "${MAC}" || true
echo

if is_paired || bluetoothctl devices Paired 2>/dev/null | grep -qi "${MAC}"; then
  echo "OK: ${MAC} is paired. Retry API command now."
  exit 0
fi

echo "ERROR: ${MAC} does not look paired (expect rc=${PAIR_RC})." >&2
echo "Tips: closer to Pi, pairing mode active, forget phone/Gira-app bond, retry." >&2
exit 1
