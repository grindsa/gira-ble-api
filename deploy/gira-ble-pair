#!/usr/bin/env bash
# Pair a Gira System 3000 device with BlueZ (Raspberry Pi).
#
# Usage:
#   sudo gira-ble-pair C7:F5:40:A6:81:66
#   sudo gira-ble-pair -s 30 C7:F5:40:A6:81:66
#
# Put the device into pairing mode (BT / blue LED blinking) BEFORE / when prompted.
#
# Gira thermostats and covers request User Confirm (often passkey 000000).
# NoInputNoOutput fails with AuthenticationCanceled — we use DisplayYesNo
# capability and auto-accept via btmgmt user-confirm-reply.

set -euo pipefail

DEFAULT_SCAN_SECONDS=20
SCAN_SECONDS="${GIRA_BLE_PAIR_SCAN_SECONDS:-$DEFAULT_SCAN_SECONDS}"
CONFIRM_TRIES="${GIRA_BLE_PAIR_CONFIRM_TRIES:-60}"
STOP_SERVICE="${GIRA_BLE_PAIR_STOP_SERVICE:-1}"
SERVICE_NAME="${GIRA_BLE_SERVICE:-gira-ble-api}"
FORCE_PAIR=0

usage() {
  cat <<EOF
Usage: $(basename "$0") [options] <MAC>

Pair/trust a Gira BLE device via BlueZ (auto-confirms passkey).

Options:
  -s, --seconds N   BLE scan window before pair (default ${DEFAULT_SCAN_SECONDS})
  -f, --force       Pair even if the MAC was not seen during scan
  -h, --help        Show this help

Example:
  sudo $(basename "$0") C7:F5:40:A6:81:66
  sudo $(basename "$0") -s 30 C7:F5:40:A6:81:66

Env (overridden by flags when set):
  GIRA_BLE_PAIR_SCAN_SECONDS    discover window (default ${DEFAULT_SCAN_SECONDS})
  GIRA_BLE_PAIR_CONFIRM_TRIES   confirm poll attempts (default ${CONFIRM_TRIES})
  GIRA_BLE_PAIR_STOP_SERVICE    stop ${SERVICE_NAME} during pair (default 1)
EOF
}

device_seen() {
  bluetoothctl devices 2>/dev/null | grep -qi "${MAC}"
}

normalize_mac() {
  local raw="${1^^}"
  raw="${raw//-/:}"
  raw="${raw//./:}"
  printf '%s\n' "${raw}"
}

valid_mac() {
  [[ "${1}" =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]]
}

is_paired() {
  bluetoothctl info "${MAC}" 2>/dev/null | grep -qi 'Paired: yes'
}

cleanup() {
  if [[ -n "${CONFIRMER_PID:-}" ]]; then
    kill "${CONFIRMER_PID}" >/dev/null 2>&1 || true
    wait "${CONFIRMER_PID}" 2>/dev/null || true
  fi
  bluetoothctl scan off >/dev/null 2>&1 || true
  if [[ "${SERVICE_WAS_ACTIVE:-0}" -eq 1 ]]; then
    echo "==> Restarting ${SERVICE_NAME}"
    systemctl start "${SERVICE_NAME}" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

MAC_ARG=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -s | --seconds)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for $1" >&2
        usage >&2
        exit 2
      fi
      SCAN_SECONDS="$2"
      shift 2
      ;;
    --seconds=*)
      SCAN_SECONDS="${1#*=}"
      shift
      ;;
    -f | --force)
      FORCE_PAIR=1
      shift
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ -n "${MAC_ARG}" ]]; then
        echo "Unexpected argument: $1" >&2
        usage >&2
        exit 2
      fi
      MAC_ARG="$1"
      shift
      ;;
  esac
done

if [[ -z "${MAC_ARG}" ]]; then
  usage >&2
  exit 2
fi

if ! [[ "${SCAN_SECONDS}" =~ ^[0-9]+$ ]] || [[ "${SCAN_SECONDS}" -lt 1 ]]; then
  echo "Invalid --seconds value: ${SCAN_SECONDS} (need integer >= 1)" >&2
  exit 2
fi

if [[ "${EUID}" -ne 0 ]]; then
  echo "Run as root (e.g. sudo $(basename "$0") ${MAC_ARG})." >&2
  exit 1
fi

if ! command -v bluetoothctl >/dev/null 2>&1; then
  echo "bluetoothctl not found (install bluez)." >&2
  exit 1
fi

if ! command -v btmgmt >/dev/null 2>&1; then
  echo "btmgmt not found (install bluez)." >&2
  exit 1
fi

MAC="$(normalize_mac "${MAC_ARG}")"
if ! valid_mac "${MAC}"; then
  echo "Invalid MAC address: ${MAC_ARG} (expected AA:BB:CC:DD:EE:FF)" >&2
  exit 2
fi

SERVICE_WAS_ACTIVE=0
if [[ "${STOP_SERVICE}" == "1" ]] && systemctl is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
  echo "==> Stopping ${SERVICE_NAME} so it does not hold the adapter"
  systemctl stop "${SERVICE_NAME}"
  SERVICE_WAS_ACTIVE=1
  sleep 1
fi

echo "==> Target ${MAC}"
echo "==> Put the device in pairing mode (BT icon / blue LED blinking),"
echo "    stay within ~1 m of the Pi, then press Enter…"
read -r _

echo "==> Removing any previous bond"
bluetoothctl remove "${MAC}" >/dev/null 2>&1 || true

echo "==> Adapter: power / connectable / bondable"
btmgmt power on >/dev/null
btmgmt connectable on >/dev/null
btmgmt bondable on >/dev/null

echo "==> Scanning ${SCAN_SECONDS}s (scan stays on through pair)…"
bluetoothctl scan on >/dev/null 2>&1 || true
sleep "${SCAN_SECONDS}"

if ! device_seen; then
  if [[ "${FORCE_PAIR}" -eq 1 ]]; then
    echo "WARNING: ${MAC} not seen during scan — continuing because --force."
  else
    bluetoothctl scan off >/dev/null 2>&1 || true
    echo "ERROR: ${MAC} was not discovered during the ${SCAN_SECONDS}s scan." >&2
    echo "  - Re-enter pairing mode (icon/LED must still be blinking)" >&2
    echo "  - Stand closer; forget phone/Gira-app bond for this unit" >&2
    echo "  - Do NOT kill bluetoothd — only stop ${SERVICE_NAME}" >&2
    echo "  - Retry with a longer window: -s 45" >&2
    echo "  - Or override: --force (usually still fails if not advertising)" >&2
    exit 1
  fi
else
  echo "==> Seen in scan: $(bluetoothctl devices 2>/dev/null | grep -i "${MAC}" || true)"
fi

echo "==> Starting User Confirm auto-acceptor"
# Gira units prompt User Confirm 000000; accept as soon as BlueZ asks.
(
  for _ in $(seq 1 "${CONFIRM_TRIES}"); do
    if btmgmt user-confirm-reply -p 1 "${MAC}" >/dev/null 2>&1; then
      echo "==> Confirmed pairing for ${MAC}"
      exit 0
    fi
    sleep 0.25
  done
  exit 0
) &
CONFIRMER_PID=$!

echo "==> Pair ${MAC} (LE Random, DisplayYesNo) — keep pairing mode active"
set +e
PAIR_OUT="$(btmgmt pair -c 1 -t 2 "${MAC}" 2>&1)"
PAIR_RC=$?
set -e
printf '%s\n' "${PAIR_OUT}"

bluetoothctl scan off >/dev/null 2>&1 || true

# Give confirmer a moment to finish if pair returned quickly.
sleep 1
kill "${CONFIRMER_PID}" >/dev/null 2>&1 || true
wait "${CONFIRMER_PID}" 2>/dev/null || true
CONFIRMER_PID=""

echo "==> Trust ${MAC}"
bluetoothctl trust "${MAC}" >/dev/null 2>&1 || true

if is_paired || bluetoothctl devices Paired 2>/dev/null | grep -qi "${MAC}"; then
  : # skip connect probe when already paired
else
  echo "==> Connect (optional verification)"
  set +e
  CONN_OUT="$(bluetoothctl connect "${MAC}" 2>&1)"
  CONN_RC=$?
  set -e
  printf '%s\n' "${CONN_OUT}"
  if [[ "${CONN_RC}" -eq 0 ]]; then
    sleep 1
    bluetoothctl disconnect "${MAC}" >/dev/null 2>&1 || true
  fi
fi

sleep 1
echo
echo "==> Device info:"
bluetoothctl info "${MAC}" || true
echo

if is_paired; then
  echo "OK: ${MAC} is paired. Retry API command now."
  exit 0
fi

if bluetoothctl devices Paired 2>/dev/null | grep -qi "${MAC}"; then
  echo "OK: ${MAC} listed under devices Paired."
  exit 0
fi

echo "ERROR: ${MAC} does not look paired (btmgmt rc=${PAIR_RC})." >&2
echo "Tips: closer to Pi, pairing mode active, forget phone/Gira-app bond, retry." >&2
exit 1
